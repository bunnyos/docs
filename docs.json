{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "bunnyOS",
  "description": "Guides for bunny, the personal AI agent that lives in Telegram, and the bunnyOS network behind it. Chat, remember, research, and earn Carrots by staking OS or supplying compute.",
  "colors": {
    "primary": "#2962FF",
    "light": "#5B82FF",
    "dark": "#1E4FD6"
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "tabs": [
      {
        "tab": "User Guide",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "user/getting-started/introduction",
              "user/getting-started/start-chatting",
              "user/getting-started/mini-app"
            ]
          },
          {
            "group": "Chatting with bunny",
            "icon": "message-circle",
            "expanded": true,
            "pages": [
              "user/chat/chat-intro",
              "user/chat/built-in-tools",
              "user/chat/memory",
              "user/chat/calendar-and-automations",
              "user/chat/connected-apps",
              "user/chat/group-chats"
            ]
          },
          {
            "group": "Carrots & OS",
            "icon": "carrot",
            "pages": [
              "user/carrots/explained",
              "user/carrots/your-carrots",
              "user/carrots/bunny-pro",
              "user/carrots/stake-os",
              "user/carrots/migrate-carrots"
            ]
          },
          {
            "group": "Contribute compute",
            "icon": "cpu",
            "pages": [
              "user/compute/overview",
              "user/compute/native-worker"
            ]
          },
          {
            "group": "Developers",
            "icon": "code",
            "pages": [
              "user/developer/inference-api"
            ]
          }
        ]
      }
    ]
  },
  "x-disabled-whitepaper-tab": {
    "tab": "Whitepaper",
    "icon": "scroll-text",
    "href": "https://bunnyos.ai/whitepaper"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Chat with bunny",
      "href": "https://t.me/bunnyagentbot"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/officialbunnyos"
    }
  }
}
